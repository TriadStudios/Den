// The js-framework-benchmark app (keyed), written in den.

type Row struct {
	ID    int
	Label *Signal[string]
}

func adjectives() []string {
	return []string{"pretty", "large", "big", "small", "tall", "short", "long", "handsome", "plain", "quaint",
		"clean", "elegant", "easy", "angry", "crazy", "helpful", "mushy", "odd", "unsightly", "adorable",
		"important", "inexpensive", "cheap", "expensive", "fancy"}
}

func colours() []string {
	return []string{"red", "yellow", "blue", "green", "pink", "brown", "purple", "brown", "white", "black", "orange"}
}

func nouns() []string {
	return []string{"table", "chair", "house", "bbq", "desk", "car", "pony", "cookie", "sandwich", "burger",
		"pizza", "mouse", "keyboard"}
}

func without(rows []Row, id int) []Row {
	out := make([]Row, 0, len(rows))
	for _, r := range rows {
		if r.ID != id {
			out = append(out, r)
		}
	}
	return out
}

func danger(on bool) string {
	if on {
		return "danger"
	}
	return ""
}

component App() {
	rows := signal([]Row(nil))
	selected := signal(0)
	seed := 1
	nextID := 1
	adj, col, noun := adjectives(), colours(), nouns()
	rnd := func(n int) int {
		seed = seed * 16807 % 2147483647
		return seed % n
	}
	build := func(n int) []Row {
		out := make([]Row, 0, n)
		for range n {
			label := adj[rnd(len(adj))] + " " + col[rnd(len(col))] + " " + noun[rnd(len(noun))]
			out = append(out, Row{ID: nextID, Label: signal(label)})
			nextID++
		}
		return out
	}
	<div class="container">
		<div class="jumbotron">
			<h1>Den keyed</h1>
			<div class="buttons">
				<button id="run" onclick={rows.Set(build(1000))}>Create 1,000 rows</button>
				<button id="runlots" onclick={rows.Set(build(10000))}>Create 10,000 rows</button>
				<button id="add" onclick={rows.Set(append(rows.Get(), build(1000)...))}>
					Append 1,000 rows
				</button>
				<button
					id="update"
					onclick={
						xs := rows.Get()
						for i := 0; i < len(xs); i += 10 {
							xs[i].Label.Set(xs[i].Label.Get() + " !!!")
						}
					}>
					Update every 10th row
				</button>
				<button id="clear" onclick={rows.Set(nil)}>Clear</button>
				<button
					id="swaprows"
					onclick={
						xs := rows.Get()
						if len(xs) > 998 {
							out := append([]Row{}, xs...)
							out[1], out[998] = out[998], out[1]
							rows.Set(out)
						}
					}>
					Swap Rows
				</button>
			</div>
		</div>
		<table class="table">
			<tbody>
				{for _, r := range rows.Get() key r.ID {
					<tr class={danger(selected.Get() == r.ID)}>
						<td class="col-md-1">{r.ID}</td>
						<td class="col-md-4">
							<a class="lbl" onclick={selected.Set(r.ID)}>{r.Label.Get()}</a>
						</td>
						<td class="col-md-1">
							<a class="remove" onclick={rows.Set(without(rows.Get(), r.ID))}>
								<span class="glyphicon glyphicon-remove" aria-hidden="true">×</span>
							</a>
						</td>
						<td class="col-md-6"></td>
					</tr>
				}}
			</tbody>
		</table>
	</div>
}
