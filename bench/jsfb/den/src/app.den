// The js-framework-benchmark app (keyed), written in den.

type Row struct {
	ID    int
	Label *Signal[string]
}

func adjectives() []string {
	return []string{"pretty", "large", "big", "small", "tall", "short", "long", "handsome", "plain", "quaint",
		"clean", "elegant", "easy", "angry", "crazy", "helpful", "mushy", "odd", "unsightly", "adorable",
		"important", "inexpensive", "cheap", "expensive", "fancy"}
}

func colours() []string {
	return []string{"red", "yellow", "blue", "green", "pink", "brown", "purple", "brown", "white", "black", "orange"}
}

func nouns() []string {
	return []string{"table", "chair", "house", "bbq", "desk", "car", "pony", "cookie", "sandwich", "burger",
		"pizza", "mouse", "keyboard"}
}

func without(rows []Row, id int) []Row {
	out := make([]Row, 0, len(rows))
	for _, r := range rows {
		if r.ID != id {
			out = append(out, r)
		}
	}
	return out
}

func danger(on bool) string {
	if on {
		return "danger"
	}
	return ""
}

component Button(id string, title string, action func()) {
	<div class="col-sm-6 smallpad">
		<button type="button" class="btn btn-primary btn-block" id={id} onclick={action()}>
			{title}
		</button>
	</div>
}

component App() {
	rows := signal([]Row(nil))
	selected := signal(0)
	nextID := 1
	adj, col, noun := adjectives(), colours(), nouns()
	// Den code cannot call JavaScript, so it has no Math.random: labels come
	// from a Park-Miller generator seeded with 1 instead.
	seed := 1
	random := func(n int) int {
		seed = seed * 16807 % 2147483647
		return seed % n
	}
	build := func(n int) []Row {
		out := make([]Row, 0, n)
		for range n {
			label := adj[random(len(adj))] + " " + col[random(len(col))] + " " + noun[random(len(noun))]
			out = append(out, Row{ID: nextID, Label: signal(label)})
			nextID++
		}
		return out
	}
	<div id="main">
		<div class="container">
			<div class="jumbotron">
				<div class="row">
					<div class="col-md-6">
						<h1>Den keyed</h1>
					</div>
					<div class="col-md-6">
						<div class="row">
							<Button
								id="run"
								title="Create 1,000 rows"
								action={func() { rows.Set(build(1000)) }} />
							<Button
								id="runlots"
								title="Create 10,000 rows"
								action={func() { rows.Set(build(10000)) }} />
							<Button
								id="add"
								title="Append 1,000 rows"
								action={func() { rows.Set(append(rows.Get(), build(1000)...)) }} />
							<Button
								id="update"
								title="Update every 10th row"
								action={func() {
									xs := rows.Get()
									for i := 0; i < len(xs); i += 10 {
										xs[i].Label.Set(xs[i].Label.Get() + " !!!")
									}
								}} />
							<Button id="clear" title="Clear" action={func() { rows.Set(nil) }} />
							<Button
								id="swaprows"
								title="Swap Rows"
								action={func() {
									xs := rows.Get()
									if len(xs) > 998 {
										out := append([]Row{}, xs...)
										out[1], out[998] = out[998], out[1]
										rows.Set(out)
									}
								}} />
						</div>
					</div>
				</div>
			</div>
			<table class="table table-hover table-striped test-data">
				<tbody id="tbody">
					{for _, r := range rows.Get() key r.ID {
						<tr class={danger(selected.Get() == r.ID)}>
							<td class="col-md-1">{r.ID}</td>
							<td class="col-md-4">
								<a onclick={selected.Set(r.ID)}>{r.Label.Get()}</a>
							</td>
							<td class="col-md-1">
								<a onclick={rows.Set(without(rows.Get(), r.ID))}>
									<span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
								</a>
							</td>
							<td class="col-md-6"></td>
						</tr>
					}}
				</tbody>
			</table>
			<span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true"></span>
		</div>
	</div>
}
