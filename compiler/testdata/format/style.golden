const (
	Ink den.Color  = "#111"
	Pad den.Length = "8px"
)

component App() {
	style {
		/* the card */
		.card {
			padding: $pad;
			color: $ink;
			border: 1px solid #ddd;
			animation: fade 1s;
		}
		.card h2, .card h3, .card h4 {
			margin: 0;
		} /* headings */
		.card-title-one-long-selector,
		.card-title-two-long-selector,
		.card-title-three {
			font-weight: 600;
		}
		@media (min-width: 40rem) {
			.card {
				padding: calc($pad * 2);
			}
		}
		@keyframes fade {
			from {
				opacity: 0;
			}
			to {
				opacity: 1;
			}
		}
		.card::before {
			content: "  two  spaces  ";
			background: url(a.png);
		}
		.empty {}

		a:not( .x ) > b {
			color: red;
			font-family: "Helvetica Neue", sans-serif /* fallback */;
		}
	}
	<div class="card"><h2>Title</h2><p class="empty"><a>x</a><b>y</b></p></div>
}

component Small() {
	n := 1
	style {
		p {
			color: $ink;
		}
	}
	m := n + 1
	<p>{m}</p>
}
