// Unary operators next to other operators. Den writes JS in which they
// cannot run together: - -y is not the decrement --y, nor + +y ++y.

func run() string {
	y, a, b := 2, 5, 3
	c := true
	out := itoa(- -y) + "," + itoa(+ +y) + "," + itoa(-+y) + "," + itoa(+-y)
	out += "," + itoa(a - -b) + "," + itoa(a + +b) + "," + itoa(a - -b) + "," + itoa(a - - -b)
	out += "," + itoa(-(-y)) + "," + itoa(-(-y)) + "," + itoa(- -(-y))
	out += "," + itoa(^^y) + "," + itoa(^-y) + "," + itoa(-^y)
	if !!c && !(!c) == c {
		out += ",t"
	}
	out += "," + itoa(y - -1) + "," + itoa(-(-1)) + "," + itoa(y - - -1) + "," + itoa(y + +1)
	n := 0
	for i := 0; i < - -y; i++ {
		n++
	}
	for range - -y {
		n++
	}
	if - -y > 1 && + +y > 1 {
		n++
	}
	x := - -y
	x -= -y
	x += -+y
	x = x - -x
	return out + "," + itoa(n) + "," + itoa(x) + "," + itoa(y)
}
