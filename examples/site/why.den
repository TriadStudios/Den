// Why den: how it differs, and when to pick something else. Qualitative
// only: no numbers for other frameworks.

// compare is the table: a header row, then one row per question.
func compare() [][]string {
	return [][]string{
		{"", "den", "React", "Svelte", "Solid"},
		{"You write", "Go", "JSX", "Svelte files", "JSX"},
		{"Types", "Go's, always", "TS, optional", "TS, optional", "TS, optional"},
		{"Updates", "Signals", "Virtual DOM", "Signals", "Signals"},
		{"Toolchain", "One Go binary", "npm", "npm", "npm"},
		{"Strict CSP", "Built in", "Up to you", "Up to you", "Up to you"},
		{"Ecosystem", "Tiny", "Huge", "Large", "Growing"},
	}
}

component Why() {
	<section>
		<header>
			<h1>For Go developers who ship to the browser</h1>
			<p class="lede">
				The language and type checker you know, with no JavaScript toolchain at all.
			</p>
		</header>
		<div class="scroll">
			<table>
				{for i, row := range compare() key i {
					<tr>
						{for j, cell := range row key j {
							{if i == 0 || j == 0 {
								<th>{cell}</th>
							} else {
								<td>{cell}</td>
							}}
						}}
					</tr>
				}}
			</table>
		</div>
		<h2>When to pick something else</h2>
		<p>
			Den is experimental and will change before 1.0. It has no server rendering yet, its Go has no methods or interfaces, and its ecosystem is one repository.
		</p>
	</section>
}
