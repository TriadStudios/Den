// The performance page: the budgets every release holds and the
// benchmark numbers, as bars that grow in when the page enters.

import "strconv"

// Bar is a labelled value: V on the chart's scale, and Text as shown.
type Bar struct {
	Label string
	V     int
	Text  string
}

type Chart struct {
	Title string
	Max   int
	Mark  int
	Rows  []Bar
}

func charts() []Chart {
	return []Chart{
		{"Budgets every release holds", 100, 0, []Bar{
			{"Runtime, gzipped", 100, "3.0 of 3 KB"}, {"TodoMVC, gzipped", 54, "5.4 of 10 KB"},
			{"Time vs vanilla JS", 77, "1.00 of 1.3×"}, {"Memory vs vanilla JS", 96, "1.15 of 1.2×"},
		}},
		{"Time per operation, den ÷ vanilla JS", 130, 100, []Bar{
			{"Create 1,000 rows", 103, "1.03"}, {"Replace 1,000 rows", 96, "0.96"}, {"Update every 10th row", 108, "1.08"},
			{"Select row", 102, "1.02"}, {"Swap rows", 97, "0.97"}, {"Remove row", 89, "0.89"},
			{"Create 10,000 rows", 98, "0.98"}, {"Append 1,000 rows", 110, "1.10"}, {"Clear 1,000 rows", 101, "1.01"},
		}},
	}
}

component Perf() {
	<section>
		<header>
			<h1>As fast as hand-written JavaScript</h1>
			<p class="lede">
				On the js-framework-benchmark operations den runs at 1.00× the time of vanilla JS.
			</p>
		</header>
		{for _, c := range charts() key c.Title {
			<div class="chart">
				<h2>{c.Title}</h2>
				{for _, b := range c.Rows key b.Label {
					<p>
						{b.Label}
						<svg aria-hidden="true">
							<rect width="100%" height="10" rx="5" />
							<rect width={strconv.Itoa(b.V*100/c.Max) + "%"} height="10" rx="5" />
							<line
								x1={strconv.Itoa(c.Mark*100/c.Max) + "%"}
								x2={strconv.Itoa(c.Mark*100/c.Max) + "%"}
								y2="10" />
						</svg>
						<b>{b.Text}</b>
					</p>
				}}
			</div>
		}}
		<p class="note">
			Medians of 15 runs in Chromium against hand-optimized vanilla JS. Memory after 1,000 rows: 2.24 MB against 1.94 MB.
		</p>
		<a href="https://github.com/TriadStudios/Den/tree/main/bench">How it is measured →</a>
	</section>
}
